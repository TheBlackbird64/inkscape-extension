<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension
    xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Manage distant server files</name>
    <id>manage-server-files</id>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Synchro"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">manage.py</command>
    </script>
</inkscape-extension>
