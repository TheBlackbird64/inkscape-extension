<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension
    xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Load from a distant server</name>
    <id>load-from-a-server</id>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Document"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">pull.py</command>
    </script>
</inkscape-extension>