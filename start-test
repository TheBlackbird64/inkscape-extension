#!/bin/bash
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
EXT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/inkscape/extensions"
LIBS_DIR="$EXT_DIR/libs"

echo $SCRIPT_DIR
echo $EXT_DIR
echo $LIBS_DIR

mkdir -p "$LIBS_DIR"

if command -v python3 >/dev/null 2>&1; then
    python3 -m pip install --target "$LIBS_DIR" requests >/dev/null 2>&1 || \
    python3 -m pip install --target "$LIBS_DIR" requests
else
    echo "Python 3 n'est pas installé ou n'est pas dans le PATH."
    exit 1
fi

cp -f "$SCRIPT_DIR/inx-files/load.inx" "$EXT_DIR/"
cp -f "$SCRIPT_DIR/inx-files/save.inx" "$EXT_DIR/"
cp -f "$SCRIPT_DIR/push.py" "$EXT_DIR/"
cp -f "$SCRIPT_DIR/pull.py" "$EXT_DIR/"

echo "Fichiers copiés dans : $EXT_DIR"

if command -v inkscape >/dev/null 2>&1; then
    echo "Lancement d'Inkscape..."
    inkscape
else
    echo "Inkscape n'est pas installé ou n'est pas dans le PATH."
    echo "Tu peux le lancer manuellement ensuite."
fi

